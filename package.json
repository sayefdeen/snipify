{
  "name": "snipify",
  "displayName": "Snipify",
  "description": "Save, manage, and reuse code snippets — synced to GitHub Gists or Bitbucket",
  "version": "0.0.1",
  "publisher": "srawad",
  "icon": "assets/snipify_icon_128.png",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e1b2e",
    "theme": "dark"
  },
  "author": {
    "name": "Saif Alrawad",
    "email": "sayefdeen.alrawad@gmail.com"
  },
"repository": {
    "type": "git",
    "url": "https://github.com/sayefdeen/snipify"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "snippets",
    "snippet manager",
    "gist",
    "github",
    "bitbucket",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snipify",
          "title": "Snipify",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "snipify": [
        {
          "id": "snipify.mainView",
          "name": "My Snippets",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "snipify.saveSnippet",
        "title": "Snipify: Save Snippet"
      },
      {
        "command": "snipify.exportSnippets",
        "title": "Snipify: Export Snippets"
      },
      {
        "command": "snipify.importSnippets",
        "title": "Snipify: Import Snippets"
      },
      {
        "command": "snipify.login",
        "title": "Snipify: Login with GitHub"
      },
      {
        "command": "snipify.logout",
        "title": "Snipify: Logout"
      },
      {
        "command": "snipify.search",
        "title": "Snipify: Search Snippets"
      },
      {
        "command": "snipify.refresh",
        "title": "Snipify: Refresh Snippets",
        "icon": "$(refresh)"
      },
      {
        "command": "snipify.newSnippet",
        "title": "Snipify: New Snippet",
        "icon": "$(add)"
      },
      {
        "command": "snipify.snippetMenu",
        "title": "Snipify: More Actions",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snipify.saveSnippet",
          "when": "editorHasSelection",
          "group": "snipify"
        }
      ],
      "view/title": [
        {
          "command": "snipify.newSnippet",
          "when": "view == snipify.mainView",
          "group": "navigation@1"
        },
        {
          "command": "snipify.refresh",
          "when": "view == snipify.mainView",
          "group": "navigation@2"
        },
        {
          "command": "snipify.snippetMenu",
          "when": "view == snipify.mainView",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "snipify.search",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      }
    ],
    "configuration": {
      "title": "Snipify",
      "properties": {
        "snipify.provider": {
          "type": "string",
          "default": "github",
          "enum": [
            "github",
            "bitbucket"
          ],
          "description": "The platform to use for storing snippets"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  }
}
