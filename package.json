{
  "name": "snipify",
  "displayName": "Snipify",
  "description": "Save, manage, and reuse code snippets synced to GitHub Gists",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snipify",
          "title": "Snipify",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "snipify": [
        {
          "id": "snipify.snippetsView",
          "name": "My Snippets"
        }
      ]
    },
    "commands": [
      { "command": "snipify.saveSnippet", "title": "Snipify: Save Snippet" },
      { "command": "snipify.insertSnippet", "title": "Snipify: Insert Snippet" },
      { "command": "snipify.deleteSnippet", "title": "Snipify: Delete Snippet", "icon": "$(trash)" },
      { "command": "snipify.editSnippet", "title": "Snipify: Edit Snippet", "icon": "$(edit)" },
      { "command": "snipify.login", "title": "Snipify: Login with GitHub" },
      { "command": "snipify.logout", "title": "Snipify: Logout" },
      {
        "command": "snipify.refresh",
        "title": "Snipify: Refresh Snippets",
        "icon": "$(refresh)"
      },
      {
        "command": "snipify.search",
        "title": "Snipify: Search Snippets"
      },
      {
        "command": "snipify.pinSnippet",
        "title": "Snipify: Pin Snippet",
        "icon": "$(pinned)"
      },
      {
        "command": "snipify.unpinSnippet",
        "title": "Snipify: Unpin Snippet",
        "icon": "$(pinned)"
      },
      {
        "command": "snipify.filterSnippets",
        "title": "Snipify: Filter Snippets",
        "icon": "$(search)"
      },
      {
        "command": "snipify.clearFilter",
        "title": "Snipify: Clear Filter",
        "icon": "$(search-stop)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snipify.saveSnippet",
          "when": "editorHasSelection",
          "group": "snipify"
        }
      ],
      "view/title": [
        {
          "command": "snipify.clearFilter",
          "when": "view == snipify.snippetsView && snipify:filterActive",
          "group": "navigation@1"
        },
        {
          "command": "snipify.filterSnippets",
          "when": "view == snipify.snippetsView",
          "group": "navigation@2"
        },
        {
          "command": "snipify.refresh",
          "when": "view == snipify.snippetsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "snipify.pinSnippet",
          "when": "view == snipify.snippetsView && viewItem == snippet",
          "group": "inline@1"
        },
        {
          "command": "snipify.unpinSnippet",
          "when": "view == snipify.snippetsView && viewItem == snippet.pinned",
          "group": "inline@1"
        },
        {
          "command": "snipify.editSnippet",
          "when": "view == snipify.snippetsView && viewItem =~ /^snippet/",
          "group": "inline@2"
        },
        {
          "command": "snipify.deleteSnippet",
          "when": "view == snipify.snippetsView && viewItem =~ /^snippet/",
          "group": "inline@3"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "snipify.snippetsView",
        "contents": "Sign in with GitHub to sync your snippets.\n[$(account) Login with GitHub](command:snipify.login)",
        "when": "snipify:authState == 'signed-out'"
      },
      {
        "view": "snipify.snippetsView",
        "contents": "$(sync~spin) Loading your snippets…",
        "when": "snipify:authState == 'loading'"
      },
      {
        "view": "snipify.snippetsView",
        "contents": "No snippets yet.\nSelect code in the editor, right-click, and choose **Save Snippet**.\n[$(add) Save a Snippet](command:snipify.saveSnippet)",
        "when": "snipify:authState == 'empty'"
      }
    ],
    "configuration": {
      "title": "Snipify",
      "properties": {
        "snipify.provider": {
          "type": "string",
          "default": "github",
          "enum": ["github", "gitlab", "bitbucket"],
          "description": "The platform to use for storing snippets"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0"
  }
}
